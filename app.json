{
  "expo": {
    "name": "NeHaber",
    "slug": "nehaber",
    "scheme": "nehaber",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.nehaber.app"
    },
    "android": {
      "package": "dev.nehaber.app",
      "adaptiveIcon": {
        "backgroundColor": "#1a9e4f"
      }
    }
  }
}
