{
  "expo": {
    "name": "NeHaber",
    "slug": "nehaber",
    "scheme": "nehaber",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10b981",
          "dark": { "backgroundColor": "#10b981" }
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.nehaber.app"
    },
    "android": {
      "package": "dev.nehaber.app",
      "adaptiveIcon": {
        "backgroundColor": "#1a9e4f"
      }
    }
  }
}
